{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestridge": {
    "Cors": {
      "AllowVercelPreviews": false
    },
    "Contact": {
      "RequireOrigin": true,
      "AllowedServices": ["ai", "analytics", "automation", "security", "general"],
      "MaxMessageLength": 5000,
      "DedupeWindowSeconds": 600,
      "FromDisplayName": "Kestridge Website"
    },
    "Smtp": {
      "Port": 587,
      "UseStartTls": true,
      "TimeoutSeconds": 15
    },
    "RateLimit": {
      "PermitsPerWindow": 5,
      "WindowMinutes": 10,
      "GlobalPerHour": 200
    },
    "Notify": {
      "MaxAttempts": 7,
      "SweepSeconds": 30,
      "BatchSize": 20
    },
    "Retention": {
      "Months": 24,
      "RunHourUtc": 3,
      "BatchSize": 500
    }
  }
}
