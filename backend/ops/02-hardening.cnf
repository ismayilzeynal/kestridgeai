; Kestridge AI backend - MySQL server settings this application depends on.
; Merge into my.ini (Windows: C:\ProgramData\MySQL\MySQL Server 8.0\my.ini)
; and restart the MySQL80 service.
;
; The binary log is the item everyone forgets. MySQL 8 enables it by default
; with a 30-day expiry, and its row images contain the full message body. That
; is a second copy of every inquiry, outside the reach of the 24-month purge and
; outside any window disclosed to someone who asks for their data to be deleted.
; On a single non-replicated server, skip-log-bin is preferred. If binary
; logging is kept for point-in-time recovery, 7 days is the ceiling and
; DSR-PROCESS.md has to state the window.

[mysqld]
bind-address               = 127.0.0.1
general_log                = OFF
binlog_expire_logs_seconds = 604800
sql_mode                   = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
character-set-server       = utf8mb4
collation-server           = utf8mb4_0900_ai_ci
innodb_default_row_format  = dynamic

; general_log is off by default. It is asserted here so that anyone who turns it
; on to debug is reminded that every inquiry body would land in a plaintext file.
